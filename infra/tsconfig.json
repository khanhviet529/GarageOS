// 🔒 `infra/` cũng phải được kiểm kiểu.
//
// Bốn script ở đây — `migrate`, `seed`, `media-import`, `site-domain-apply` —
// cộng lại 1.856 dòng, và KHÔNG dòng nào từng đi qua `tsc`. `turbo run
// typecheck` chỉ chạm chín gói trong `apps/*` và `packages/*`; `infra/` không
// phải workspace nên nó nằm ngoài. Còn `tsx` thì XOÁ kiểu chứ không kiểm kiểu.
//
// ⚠️ Đây là những script chạy bằng `DATABASE_ADMIN_URL` — quyền cao nhất trong
//    hệ thống, bỏ qua RLS. Chúng lại đúng là phần duy nhất không có lưới an
//    toàn nào của công cụ.
//
// `noEmit` vì không có gì cần build: `tsx` chạy thẳng từ nguồn.
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // `tsx` chạy thẳng file nguồn, nên import giữa các file ở đây ghi đuôi
    // `.ts` thật. Không có cờ này thì `tsc` từ chối chính cái đường dẫn mà
    // runtime đang dùng — kiểm kiểu sẽ mâu thuẫn với thứ đang chạy.
    "allowImportingTsExtensions": true,
    // `kiem-tuong-phan.mjs` là script `node` thuần — nó phải chạy được bằng
    // `node` trần trong `pnpm kiem:tuong-phan`, trước mọi bước biên dịch. Bài
    // `tuong-phan-mot-cong-thuc.spec.ts` import nó để so công thức với bản ở
    // domain, nên `tsc` cần đọc được file `.mjs`. `checkJs` để tắt: kiểu của
    // nó suy ra là đủ cho phép so, còn bật kiểm sẽ đòi chú thích kiểu cho một
    // script cố ý không có bước build.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["*.ts"]
}
