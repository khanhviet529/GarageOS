# Copy sang .env — KHÔNG commit .env
#
# 🔒 File này CỐ Ý để trống những giá trị nguy hiểm. Copy nguyên xi sang .env
#    thì API sẽ TỪ CHỐI KHỞI ĐỘNG kèm hướng dẫn, thay vì chạy được với cấu hình
#    sai. Chạy được với cấu hình sai là kịch bản tệ nhất: không ai biết.

# 🔒 Ứng dụng PHẢI dùng role thường (không superuser, không BYPASSRLS),
#    nếu không RLS bị bỏ qua âm thầm và cô lập tenant vô hiệu.
DATABASE_URL=postgresql://garageos_app:garageos_app_dev@localhost:5433/garageos

# Chỉ dùng để chạy migration (cần quyền chủ sở hữu)
DATABASE_ADMIN_URL=postgresql://garageos:garageos_dev@localhost:5433/garageos

REDIS_URL=redis://localhost:6380

# 🔒 BẮT BUỘC tự sinh, mỗi môi trường một giá trị khác nhau:
#       openssl rand -base64 48
#
#    Bí mật này là thứ DUY NHẤT giữ cho cô lập tenant có nghĩa. Ai biết nó thì
#    tự ký được token với `tid` của bất kỳ garage nào, và RLS sẽ mở cửa đúng như
#    thiết kế vì token hoàn toàn hợp lệ. Toàn bộ công sức dựng RLS, tách role và
#    test quyền ở tầng database chỉ mạnh bằng chuỗi này.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Số lần đăng nhập sai cho phép trong 15 phút. Mặc định của code là 5 —
# ⚠️ chỉ nới ở môi trường test, và test tự đặt biến này chứ không lấy từ đây.
# LOGIN_RATE_LIMIT_MAX=5

# ⚠️ Trả mã OTP về ngay trong response HTTP, để chạy được luồng duyệt báo giá
#    khi chưa tích hợp SMS/Zalo thật. Bật cái này ở production nghĩa là ai có
#    link tra cứu cũng tự duyệt được báo giá thay khách.
#    Mặc định TẮT — dev tự bật, CI đặt trong workflow.
OTP_DEV_ECHO=false

# Hiện danh sách tài khoản demo trên trang đăng nhập. Chỉ dùng cho bản chạy thử.
NEXT_PUBLIC_DEMO_HINTS=0

# Cookie phiên chỉ gửi qua HTTPS.
# 🔒 BẮT BUỘC 'true' ở production. Để 'false' ở máy dev vì localhost là http —
#    bật cứng thì cookie không bao giờ tới nơi và không ai đăng nhập được.
COOKIE_SECURE=false

# Web được phép gọi API. Production phải là URL HTTPS CHÍNH XÁC của web;
# không dùng `*` vì biến này vừa cấu hình CORS vừa là allow-list chống CSRF.
# 3000=web xưởng, 3002=mobile web, 3003=landing, 3004=sales-admin.
WEB_ORIGIN=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004

# ---- Landing / Sales Admin (Phase 1) --------------------------------------
# Landing SSR gọi API nội bộ bằng URL này (default http://localhost:3001).
# LANDING_INTERNAL_API=http://localhost:3001
#
# Public origin cho media (default http://localhost:3001/media — API tự serve).
# PUBLIC_MEDIA_ORIGIN=http://localhost:3001/media
#
# 🔒 Ranh giới tin cậy của tenant resolution công khai — `signed` | `host`.
#
#   signed (MẶC ĐỊNH) — chỉ tin header `X-GarageOS-Original-Host` khi kèm chữ ký
#     HMAC hợp lệ. Bắt buộc cho staging, preview VÀ production.
#   host — thêm hai lối vào không cần chữ ký (header thường, và `Host`). CHỈ
#     dùng trên máy phát triển, nơi trình duyệt gọi thẳng API.
#
# ⚠️ Đặt `host` ở nơi có người ngoài truy cập được nghĩa là BẤT KỲ AI cũng chọn
# được tenant bằng một header, và ghi lead vào tenant đó. Trước đây ranh giới
# này dựa vào `NODE_ENV` — sai, vì staging gần như luôn chạy với NODE_ENV khác
# `production`. Xem docs/reviews/2026-08-14-luong-tenant-public-landing.md.
# EDGE_HOST_TRUST=host

# Bí mật ký original-host giữa edge/SSR và API. BẮT BUỘC khi EDGE_HOST_TRUST là
# `signed` (mặc định) — thiếu nó thì mọi request landing trả 404.
# EDGE_SIGNING_SECRET=

# Số proxy THẬT đứng trước API (CDN = 1, CDN + load balancer = 2). Quyết định
# API tin bao nhiêu hop cuối của `X-Forwarded-For` khi xác định IP khách.
# ⚠️ Sai số này theo hướng nào cũng hỏng: thấp quá thì mọi khách dùng chung IP
# của edge và chia nhau một hạn mức; cao quá thì client tự khai IP và thoát mọi
# giới hạn. Mặc định 0 = chạy trần, dùng IP của kết nối.
# TRUST_PROXY_HOPS=1

# Giới hạn form lead công khai: số lượt mỗi (hostname, IP) trong mỗi cửa sổ.
# LEAD_RATE_LIMIT_MAX=10
# LEAD_RATE_LIMIT_WINDOW_MS=600000

# Origin API cho browser của landing (dev). Production để trống — dùng same-origin.
# NEXT_PUBLIC_PUBLIC_API_ORIGIN=http://localhost:3001

# Origin API cho browser của sales-admin (dev).
# NEXT_PUBLIC_ADMIN_API_ORIGIN=http://localhost:3001

# ---- Lưu trữ ảnh (Phase 4.3) ----------------------------------------------
# `local` = đĩa của chính máy chạy API. ⚠️ Chỉ dùng cho dev và bản demo một máy:
# chạy nhiều instance thì ảnh tải lên ở instance này trả 404 ở instance kia.
# `s3` = object storage tương thích S3 — MinIO ở máy dev, S3/R2 ở production.
# 🔒 Đặt `s3` mà thiếu bí mật thì API TỪ CHỐI KHỞI ĐỘNG, không tự rơi về local:
#    ảnh hiện trạng là bằng chứng, không được nằm trên đĩa tạm rồi biến mất.
STORAGE_DRIVER=local
MEDIA_ROOT=
# `docker compose up -d minio` dựng sẵn ở cổng 9002 (console 9003).
# S3_ENDPOINT=http://localhost:9002
# S3_BUCKET=garageos-media
# S3_ACCESS_KEY=garageos
# S3_SECRET_KEY=garageos_dev
# S3_REGION=us-east-1
