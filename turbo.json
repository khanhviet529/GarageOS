{
  "$schema": "https://turbo.build/schema.json",

  /*
   * 🔒 Turbo 2 mặc định chạy task ở chế độ env NGHIÊM NGẶT: task chỉ nhận
   *    những biến môi trường được khai ở đây, không phải cả môi trường của
   *    tiến trình cha.
   *
   * ⚠️ Điều đó âm thầm cho tới khi có thứ gì KHÔNG có giá trị mặc định. Bộ test
   *    trên `main` sống sót vì mọi chỗ đọc env đều có fallback:
   *
   *        process.env.DATABASE_ADMIN_URL ?? 'postgresql://…@localhost:5433/…'
   *
   *    `run-api-tests.mjs` (nhánh này thêm) tự khởi động API từ TRONG một task
   *    của turbo, và `assertSecretsUsable()` CỐ Ý không có mặc định cho bí mật
   *    JWT. Trên CI:
   *
   *        Khởi động thất bại: Cấu hình không an toàn, API từ chối khởi động:
   *          • JWT_ACCESS_SECRET chưa được đặt
   *          • JWT_REFRESH_SECRET chưa được đặt
   *
   * 💡 Fallback trong code làm cho việc thiếu cấu hình trông như không thiếu.
   *    Chỗ duy nhất KHÔNG có fallback lại là chỗ đầu tiên nói ra sự thật — và
   *    nó nói vào lượt CI thứ tư.
   *
   * Khai ở `globalEnv` chứ không `globalPassThroughEnv`: các biến này ĐỔI kết
   * quả chạy, nên chúng phải nằm trong hash của cache.
   */
  "globalEnv": [
    "CI",
    "DATABASE_URL",
    "DATABASE_ADMIN_URL",
    "REDIS_URL",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "JWT_ACCESS_TTL",
    "JWT_REFRESH_TTL",
    "API_PORT",
    "API_URL",
    "WEB_ORIGIN",
    "COOKIE_SECURE",
    "OTP_DEV_ECHO",
    "LOGIN_RATE_LIMIT_MAX",
    "LOGIN_RATE_LIMIT_WINDOW_MS",
    "LEAD_RATE_LIMIT_MAX",
    "LEAD_RATE_LIMIT_WINDOW_MS",
    "EDGE_HOST_TRUST",
    "EDGE_SIGNING_SECRET",
    "TRUST_PROXY_HOPS",
    "LANDING_INTERNAL_API",
    "PUBLIC_MEDIA_ORIGIN",
    "MEDIA_ROOT",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_DEMO_HINTS",
    "NEXT_PUBLIC_PUBLIC_API_ORIGIN",
    "NEXT_PUBLIC_ADMIN_API_ORIGIN"
  ],

  "tasks": {
    "build":      { "dependsOn": ["^build"], "outputs": ["dist/**", ".next/**"] },
    "lint":       { "dependsOn": ["^build"] },
    "typecheck":  { "dependsOn": ["^build"] },

    // 🔒 `cache: false` cho CẢ HAI task test — không phải tối ưu bị bỏ sót.
    //
    // Turbo quyết định cache-hit theo hash của TỆP TRONG KHO. Nhưng bộ test của
    // dự án này chạy trên một Postgres THẬT (bắt buộc — exclusion constraint và
    // RLS không tồn tại ở SQLite), và trạng thái database KHÔNG nằm trong hash
    // đó. Hệ quả: chạy migration mới, gọi `pnpm test`, thấy "xanh" — nhưng đó
    // là log PHÁT LẠI của lần chạy trước, trên một lược đồ khác.
    //
    // Nói cách khác, cache biến `pnpm test` từ một phép kiểm chứng thành một
    // phép tra bảng. Dự án này có nguyên tắc "trọng tài là code chạy được"; một
    // kết quả test được cache thì không phải code chạy được.
    //
    // Đánh đổi: mỗi lần gọi mất thêm khoảng một phút. Chấp nhận — rẻ hơn một
    // lần tin vào kết quả sai.
    //
    // (`test:invariants` đã có `cache: false` từ đợt 3; `test` thì bị bỏ sót,
    // và chỉ lộ ra khi đi tìm nguyên nhân một lượt đỏ không tái hiện được.)
    "test":            { "dependsOn": ["^build"], "cache": false },
    "test:invariants": { "dependsOn": ["^build"], "cache": false },

    "dev":        { "cache": false, "persistent": true }
  }
}
