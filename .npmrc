# =============================================================================
# Expo/Metro cần node_modules PHẲNG cho một số gói
#
# pnpm mặc định cô lập node_modules (mỗi gói chỉ thấy phụ thuộc nó khai báo).
# Đó là hành vi đúng và là lý do dự án dùng pnpm. Nhưng Metro — trình đóng gói
# của React Native — phân giải module theo cách riêng và KHÔNG đi theo symlink
# của pnpm cho một số gói nội bộ của React Native.
#
# `public-hoist-pattern` chỉ nâng ĐÚNG những gói đó lên gốc, thay vì
# `node-linker=hoisted` vốn tắt cô lập cho TOÀN BỘ workspace và làm mất chính
# thứ khiến `api`/`web` không vô tình dùng phụ thuộc chưa khai báo.
# =============================================================================
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*@react-native*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=@babel/*
confirm-modules-purge=false
